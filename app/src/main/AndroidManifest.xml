<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <application
        android:name="net.kaaass.zerotierfix.ZerotierFixApplication"
        android:allowBackup="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:icon="@drawable/tv_icon"
        android:roundIcon="@drawable/tv_icon"
        android:banner="@drawable/tv_banner"
        android:label="BlackServ ZeroTier TV"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZerotierFix"
        android:usesCleartextTraffic="true">
        <service
            android:name=".service.ZeroTierOneService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter><action android:name="android.net.VpnService" /></intent-filter>
        </service>
        <activity android:name=".ui.tv.TvHomeActivity"
            android:exported="true"
            android:label="BlackServ ZeroTier TV"
            android:banner="@drawable/tv_banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.tv.TvDiagnosticsActivity" android:exported="false" />
        <activity android:name=".ui.tv.TvBypassActivity" android:exported="false" />
        <activity android:name=".ui.NetworkListActivity" android:exported="false" />
        <activity android:name=".ui.JoinNetworkActivity" android:label="@string/join_network" />
        <activity android:name=".ui.PrefsActivity" android:label="@string/app_name" />
        <activity android:name=".ui.view.NetworkDetailActivity" android:label="@string/network_detail" />
        <activity android:name=".ui.MoonOrbitActivity" android:label="@string/moon_orbit_activity" />
        <activity android:name=".ui.PeerListActivity" android:label="@string/peer_list" />
        <receiver android:name=".service.StartupReceiver" android:exported="true">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
    </application>
</manifest>