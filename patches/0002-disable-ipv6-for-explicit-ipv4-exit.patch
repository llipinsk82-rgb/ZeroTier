index 0000000..96f5d00
--- /dev/null
+++ b/app/src/main/java/net/kaaass/zerotierfix/ui/tv/TvRoutePolicy.java
@@ -0,0 +1,14 @@
+package net.kaaass.zerotierfix.ui.tv;
+
+/**
+ * A tuner gateway configured only with IPv4 must not permit IPv6 fallthrough.
+ * VpnService.Builder blocks a family without any address, route or DNS for it.
+ */
+public final class TvRoutePolicy {
+    private TvRoutePolicy() {
+    }
+
+    public static boolean disableIpv6(boolean userDisabled, boolean selectedIpv4Gateway) {
+        return userDisabled || selectedIpv4Gateway;
+    }
+}
diff --git a/app/src/test/java/net/kaaass/zerotierfix/ui/tv/TvRoutePolicyTest.java b/app/src/test/java/net/kaaass/zerotierfix/ui/tv/TvRoutePolicyTest.java
new file mode 100644
index 0000000..88f542e
--- /dev/null
+++ b/app/src/test/java/net/kaaass/zerotierfix/ui/tv/TvRoutePolicyTest.java
@@ -0,0 +1,15 @@
+package net.kaaass.zerotierfix.ui.tv;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class TvRoutePolicyTest {
+    @Test public void explicitIpv4GatewayMustDisableIpv6() {
+        assertTrue(TvRoutePolicy.disableIpv6(false, true));
+    }
+
+    @Test public void preservesExistingUserPreferenceWithoutGatewayOverride() {
+        assertFalse(TvRoutePolicy.disableIpv6(false, false));
+        assertTrue(TvRoutePolicy.disableIpv6(true, false));
+    }
+}
